Notification {
    color: #D2D8E0;
    border: 0px solid rgb(0, 0, 0);
    background:rgb(64, 69, 82);
    margin: 0px;
}

QLabel {
    color: #D2D8E0;
}

#closeButton {
    border: none;
    padding: 2px;
    qproperty-icon: url(lxqt-notificationd/close.svg);
}

#closeButton:hover {
    border: 0px solid rgb(0, 0, 0);
    padding: 2px;
    background:rgb(47, 52, 63);
    qproperty-icon: url(lxqt-notificationd/close-hover.png);
}

#appLabel {
    font-weight: bold;
}
